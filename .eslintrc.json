{
  "root": true,
  "extends": [
    "eslint:recommended",
    "plugin:import/recommended",
    "plugin:ft-flow/recommended"
  ],
  "plugins": ["import", "ft-flow"],
  "parser": "hermes-eslint",
  "env": {
    "browser": true,
    "commonjs": true,
    "node": true,
    "es6": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "strict": ["error", "global"],
    "curly": "warn",
    "no-types-missing-file-annotation": "off"
  },
  "overrides": [
    {
      "files": [
        "docusaurus/website/src/**/*.js",
        "packages/cia-template/**/*.js",
        "packages/inferno-error-overlay/**/*.js",
        "packages/inferno-scripts/fixtures/kitchensink/template/{src,integration}/**/*.js",
        "test/fixtures/*/src/*.js"
      ],
      "excludedFiles": ["packages/inferno-error-overlay/*.js"],
      "extends": ["eslint:recommended", "plugin:inferno/recommended"]
    },
    {
      "files": [
        "test/fixtures/webpack-message-formatting/src/{AppLintError,AppLintWarning,AppUnknownFile}.js"
      ],
      "rules": {
        "no-unused-vars": "off",
        "no-undef": "off"
      }
    },
    {
      "files": ["test/fixtures/webpack-message-formatting/src/Export5.js"],
      "rules": {
        "import/no-anonymous-default-export": "off"
      }
    },
    {
      "files": ["test/fixtures/issue-5176-flow-class-properties/src/App.js"],
      "rules": {
        "no-dupe-class-members": "off"
      }
    }
  ]
}
