{
  "name": "inferno-error-overlay",
  "type": "module",
  "version": "7.0.0",
  "description": "An overlay for displaying stack frames.",
  "main": "lib/index.js",
  "sideEffects": false,
  "scripts": {
    "start": "cross-env NODE_ENV=development node build.js --watch",
    "test": "cross-env NODE_ENV=test jest",
    "build": "cross-env NODE_ENV=development node build.js",
    "build:prod": "cross-env NODE_ENV=production node build.js",
    "flow": "flow"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/infernojs/create-inferno-app.git",
    "directory": "packages/inferno-error-overlay"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/infernojs/create-inferno-app/issues"
  },
  "keywords": [
    "overlay",
    "syntax",
    "error",
    "red",
    "box",
    "redbox",
    "crash",
    "warning"
  ],
  "author": "Joe Haddad <timer150@gmail.com>",
  "files": [
    "lib/index.js"
  ],
  "devDependencies": {
    "@babel/code-frame": "^8.0.6",
    "@babel/core": "^8.0.6",
    "anser": "^2.3.5",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-preset-inferno-app": "^11.0.0",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "flow-bin": "^0.334.0",
    "html-entities": "^2.6.0",
    "inferno": "^10.0.0",
    "jest": "^30.5.2",
    "jest-fetch-mock": "^4.2.0",
    "object-assign": "^4.1.1",
    "promise": "^8.3.0",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "settle-promise": "^1.0.0",
    "source-map-js": "^1.2.2",
    "webpack": "^5.111.1"
  },
  "jest": {
    "setupFiles": [
      "./src/__tests__/setupJest.js"
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "json"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.js?(x)",
      "<rootDir>/src/**/?(*.)(spec|test).js?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/fixtures/",
      "setupJest.js"
    ]
  }
}
